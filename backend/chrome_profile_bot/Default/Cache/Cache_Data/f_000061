    <script>

        $(document).ready(function () {

            $(".menuHomeActive").addClass("active");

            $('.slideDestaque').slick({
                infinite: false,
                dots: false,
                speed: 300,
                centerMode: false,
                variableWidth: true,
                dots: false,
                prevArrow: false,
                nextArrow: false,
                slidesToScroll: 2,
            });

            var qtdePontosClientes = $(".qtdePontosClientes").attr("value");
            var pontos = $(".pontos").attr("value");

            if (qtdePontosClientes == pontos) {
                $(".presenteFidelidade").addClass("ative");
            }

            $('.lazy').lazy({
                effect: "fadeIn",
                effectTime: 200,
                threshold: 0
            });

            $('.myAccordion').on('show.bs.collapse	', function (e) {
                $(e.target).find('.lazy').each(function () {
                    $(this).attr('src', $(this).data('src'));
                });
            })

            $("#formaPagamentoFooter,#formaPagamentoOnlineFooter,#telefonesFooter,#chefmioFooter").removeClass("hidden-xs");

            //menu select
            $('#menuCatDrop').change(function () {

                $('.panel-collapse.in')
                /* .removeClass('in');*/

                var idPai = $("#menuCatDrop option:selected").attr("data-id-pai");

                if (idPai != null) {
                    if (!$("#collapse" + idPai).hasClass('collapse in')) {
                        $("#collapse" + idPai).collapse('show');
                    }

                    var $el = $($(this).find(':selected').attr('class'));
                    $('html,body').animate({
                        scrollTop: $el.offset().top - 50
                    }, 200);
                }

                var id = $("#menuCatDrop option:selected").attr("data-id");
                if (id != null) {
                    if (!$("#collapse" + id).hasClass('collapse in')) {
                        $("#collapse" + id).collapse('show');
                    }

                    var $el = $($(this).find(':selected').attr('class'));
                    $('html,body').animate({
                        scrollTop: $el.offset().top - 50
                    }, 200);
                }
            });

            //clique menu lateral
            $('.menuPrincipalLateral').click(function () {

                $('#cbxMenu').trigger('click');

                var idPai = $(this).attr("data-id-pai");
                if (idPai != null) {
                    $("#menuCatDrop").val(idPai);
                    $('#menuCatDrop').trigger('change');
                }

                var id = $(this).attr("data-id");
                if (id != null) {
                    $("#menuCatDrop").val(id);
                    $('#menuCatDrop').trigger('change');
                }

            });

            //abrirModalPagina quando abre o produto pela URL
            var urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('exibirModal') === 'True') {
                abrirModalProduto(urlParams.get('idProduto'))
            }
        });

        $("body").on("click", ".addProduto", addItem);

        function addItem() {
            // MensagemLoadAcao();
            $("#modalLoding").modal();
            var id = $(this).attr("data-id");
            abrirModalProduto(id);
        }

        function abrirModalProduto(id) {

            var parsedId = Number(id);
            if (!parsedId || parsedId <= 0) {
                console.warn('Id de produto invalido:', id);
                $("#modalLoding").modal('hide');
                window.location.reload();
                return;
            }

            $("#modalProduto").load("/Produto/DetalhesProdutoModal?idProduto=" + parsedId, function (responseText, textStatus, req) {
                if (textStatus === "error") {
                    console.error('Falha ao carregar modal do produto', req.status);
                    $("#modalLoding").modal('hide');
                    window.location.reload();
                    return;
                }

                $("#modalLoding").modal('hide');

                $("#modalProduto").modal();
            });

            $("#modalProduto").on("hidden.bs.modal", function () {
                animateCSS('.barra-sacola', 'shakeY');
            });

            try {
                if (typeof fbq !== 'undefined') {
                    fbq('track', 'CustomizeProduct');
                }
            } catch (ex) { }

        }

        function mostrarLoading() {
            document.getElementById('loadingModal').style.display = 'block';
        }

        $('[data-toggle="tooltip"]').tooltip();

        let isScrolling;

        window.onscroll = function () {

            window.clearTimeout(isScrolling);

            isScrolling = setTimeout(function () {
                // Chama a função para mostrar ou esconder a div
                identificarDivNoTopo();
            }, 50);
        };

        function identificarDivNoTopo() {
            var divMostrar = document.getElementById('divCardapio');
            var divEsconder = document.getElementById('CategoriasMenu');

            var rect = divMostrar.getBoundingClientRect();

            // Se a div-mostrar atingir o topo da janela, exibe a div-esconder
            if (rect.top <= 0) {
                divEsconder.style.display = 'block';
            } else {
                divEsconder.style.display = 'none';
            }
        }


        document.addEventListener('DOMContentLoaded', function () {
            var secoes = document.querySelectorAll('.cardapioDiv');
            var menuLinks = document.querySelectorAll('.linkCategoria');
            var isPaused = false; // Flag para controlar se o carrossel está pausado
            var ultimoLink = menuLinks[menuLinks.length - 1];

            // Inicializa o Slick Carousel
            $('.slideCategoria').slick({
                dots: false,
                infinite: false,
                speed: 300,
                centerMode: false,
                variableWidth: true,
                prevArrow: false,
                nextArrow: false,
                slidesToScroll: 3,
                responsive: [
                    {
                        breakpoint: 680,
                        settings: {
                            slidesToShow: 6
                        }
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 3
                        }
                    },
                    {
                        breakpoint: 400,
                        settings: {
                            slidesToShow: 2
                        }
                    },
                ]
            });


            window.addEventListener('scroll', function () {
                // Se o carrossel estiver pausado, não execute a lógica de rolar para o slide ativo
                if (isPaused) {
                    return;
                }

                secoes.forEach(function (secao, index) {
                    var bounding = secao.getBoundingClientRect();

                    if (bounding.top <= 180 && bounding.bottom >= 50) {
                        menuLinks.forEach(function (link) {
                            link.classList.remove('categoria-home-ativo');
                        });
                        menuLinks[index].classList.add('categoria-home-ativo');

                        // Move para o slide correspondente
                        $('.slideCategoria').slick('slickGoTo', index);
                    }
                });
            });
        });





    </script>

    

    
