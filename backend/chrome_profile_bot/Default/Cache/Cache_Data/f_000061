        function abrirPagina(rota) {
            var id = $(this).attr("data-id");
            $("#modalPagina").load(rota, function (responseText, textStatus, req) {
                if (textStatus == "error") {
                    location.reload();
                    return;
                }
                $("#modalPagina").modal();
            });

            try {
                if (typeof fbq !== 'undefined') {
                    fbq('track', 'CustomizeProduct');
                }
            } catch (ex) { }

        }

        //Fechar modal produto voltar celular*****************************
        $("#modalProduto").on("shown.bs.modal", function () {
            var urlReplace = "#" + $(this).attr('id');
            history.pushState(null, null, urlReplace);
        });

        $(window).on('popstate', function () {
            $("#modalProduto").modal('hide');
        });

        $(document).keydown(function (event) {
            if (event.keyCode == 27) {
                $("#modalProduto").modal('hide');
                location.reload();
            }
        })
        //*****************************************************************

        $(document).ready(function () {
            itensCarrinho();
        });

        function valorSacola() {

            $.ajax({
                url: "/ObterValorCarrinhoCarrinho",
                type: "GET",
                success: function (response) {
                    var valorTotalCarrinho = response.valorTotalCarrinho;
                    if (valorTotalCarrinho > 0) {
                        var valorTotalCarrinhoFormatado = valorTotalCarrinho.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                        $("#valorSacola").html(valorTotalCarrinhoFormatado);
                    }
                }
            });
        }

        function itensCarrinho() {

            $.ajax({
                url: "/ObterQtdeItensCarrinho",
                type: "GET",
                success: function (response) {
                    let qtdeItensCarrinho = response.qtdeItensCarrinho;
                    if (qtdeItensCarrinho == '0') {
                        $(".menuSacola").addClass('d-none');
                    }
                    else {
                        valorSacola();
                        $("#QuantPedido").html(qtdeItensCarrinho);
                        $(".menuSacola").removeClass('d-none');

                        if (qtdeItensCarrinho <= 1) {
                            $("#itemCarrinho").text('Item');
                        } else {
                            $("#itemCarrinho").text('Itens');
                        }
                    }
                }
            });
        }

    </script>

